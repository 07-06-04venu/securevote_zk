# SecureVote ZK - Environment Variables
# Copy this file to .env.local for local development
# For production, add these in Vercel Project Settings

# ============================================
# BLOCKCHAIN CONFIGURATION (Required for Production)
# ============================================

# Sepolia Testnet RPC URL (Get from Infura or Alchemy)
# Example: https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployed contract address on Sepolia
# After deploying, paste the contract address here
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key of deployer account (DO NOT COMMIT)
# Only needed for contract deployment
PRIVATE_KEY=your_private_key_here

# ============================================
# OPTIONAL CONFIGURATIONS
# ============================================

# Admin API Key (for monitoring dashboards)
ADMIN_API_KEY=your-secure-admin-key

# MongoDB (optional - uses file storage if not set)
# MONGODB_URI=mongodb+srv://...

# ============================================
# DEMO MODE
# ============================================
# Set to false to disable demo mode and require blockchain
# DEMO_MODE=false
